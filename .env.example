# Copy to .env.local for local development. Never commit real values.
# Leave the Supabase values empty to run the demo with fictional data.

# --- Website ---
NEXT_PUBLIC_CONTACT_EMAIL=hello@garmentflow.example
# Registered company name shown in Privacy / Terms
NEXT_PUBLIC_LEGAL_NAME=
# Optional: public sample-data demo linked from the live site
NEXT_PUBLIC_DEMO_URL=

# --- Supabase (live mode) ---
# Public values: safe in the browser, Row Level Security protects the data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public address of the deployed app, used in email links
NEXT_PUBLIC_SITE_URL=

# --- OpenAI (server only, never exposed to the browser) ---
OPENAI_API_KEY=
# Optional. Must support PDF input and structured outputs.
OPENAI_MODEL=gpt-4.1-mini
# Optional. Used only to estimate cost in the admin screens (USD per 1M tokens).
OPENAI_INPUT_USD_PER_M=0.4
OPENAI_OUTPUT_USD_PER_M=1.6
