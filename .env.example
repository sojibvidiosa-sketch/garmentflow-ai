# Copy to .env.local for local development. Never commit real values.

# --- Phase 1 (used now) ---
# Address that "Book a demo" links open.
NEXT_PUBLIC_CONTACT_EMAIL=hello@garmentflow.example

# --- Supabase (live mode). Leave empty to run the demo. ---
# Public values (safe in the browser; RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public address of the deployed app, used in email links.
NEXT_PUBLIC_SITE_URL=
# Server-only, not needed yet. Bypasses RLS — only for the Phase 6 cron job and Phase 8 admin aggregates.
SUPABASE_SECRET_KEY=

# --- Phase 4: OpenAI (not used yet, server-only) ---
OPENAI_API_KEY=
OPENAI_MODEL=
# Per-company monthly AI job limit for the pilot
AI_MONTHLY_JOB_LIMIT=300

# --- Phase 6: scheduled jobs (not used yet) ---
# Vercel Cron sends this as a bearer token; the route rejects other callers.
CRON_SECRET=
